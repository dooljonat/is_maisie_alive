[Unit]
Description=ismaisiealive.net — pug proof-of-life blog
After=network.target

[Service]
Type=simple
User=maisie
Group=maisie
WorkingDirectory=/home/maisie/IsMaisieAlive
ExecStart=/home/maisie/IsMaisieAlive/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
