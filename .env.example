# Copy to .env and change these before deploying.
ADMIN_USERNAME=jon
ADMIN_PASSWORD=change-me-before-dad-finds-out

# Minutes of allowed drift between a photo's EXIF "taken at" time and its
# upload time for the "timestamp verified" badge.
EXIF_TOLERANCE_MINUTES=90

# Household timezone: all timestamps (upload times, checklist check-offs,
# "today") use this, regardless of the server's own clock. IANA name.
TIMEZONE=America/New_York
